PORT=8787
# Comma-separated if you need more than one (defaults to the client app :4200 and the archived
# React app :5173 if left unset — see server/src/index.ts).
WEB_ORIGIN=http://localhost:4200,http://localhost:5173

# Optional — the "GitHub OAuth" login tab already works out of the box against this app's
# own OAuth App (its Client ID is baked into the server as a default; client IDs aren't
# sensitive, so this is safe to ship). Only set this if you want sign-in to go through a
# *different* OAuth App instead: create one at https://github.com/settings/developers,
# enable "Device Flow" in its settings, and paste its Client ID below.
GITHUB_OAUTH_CLIENT_ID=
