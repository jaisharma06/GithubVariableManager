{
  "name": "github-variables-manager",
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -n api,client -c blue,yellow \"npm run dev:api\" \"npm start -w client\"",
    "dev:api": "dotnet run --project api/src/GithubVariablesManager.Api/GithubVariablesManager.Api.csproj",
    "dev:client": "npm start -w client",
    "dev:archive:web": "npm run dev -w web"
  },
  "workspaces": [
    "archive/web",
    "client"
  ],
  "private": true,
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
