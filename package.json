{
  "name": "github-variables-manager",
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,yellow \"npm run dev -w server\" \"npm run dev -w web\"",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web"
  },
  "workspaces": [
    "web",
    "server"
  ],
  "private": true,
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
