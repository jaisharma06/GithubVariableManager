{
  "name": "github-variables-manager",
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,yellow \"npm run dev -w server\" \"npm start -w client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm start -w client",
    "dev:archive:web": "npm run dev -w web"
  },
  "workspaces": [
    "archive/web",
    "server",
    "client"
  ],
  "private": true,
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
